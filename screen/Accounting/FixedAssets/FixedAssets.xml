<!-- Fixed assets (design-accounting §10 FixedAssets): the organization's fixed assets with their book position: class,
    in-service day, cost, accumulated depreciation, net book, location and book state, found by class, type, facility,
    method, acquired days and disposal (ironstone.accounting.AssetBookServices.find#Assets). An asset opens EquipmentDetail
    on its book; Run depreciation opens DepreciationRunDetail. -->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        default-menu-title="Assets"
        default-menu-index="1"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId"/>
    <parameter name="classEnumId"/>
    <parameter name="assetTypeEnumId"/>
    <parameter name="facilityId"/>
    <parameter name="depreciationTypeEnumId"/>
    <parameter name="disposed"/>
    <parameter name="acquiredFrom"/>
    <parameter name="acquiredThru"/>
    <parameter name="pageIndex"/>
    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>
    <actions>
        <set field="records" from="[]"/>
        <set field="canPostLedger" from="false"/>
        <set field="isPrinting" from="String(ec.web?.requestParameters?.renderMode || context.renderMode || '') == 'html-print'"/>
        <set field="fetchPageSize" from="isPrinting ? 10000 : 20"/>
        <if condition="organizationPartyId">
            <service-call name="ironstone.accounting.AssetBookServices.find#Assets" out-map="context"
                    in-map="{organizationPartyId:organizationPartyId, classEnumId:classEnumId,
                        assetTypeEnumId:assetTypeEnumId, facilityId:facilityId, depreciationTypeEnumId:depreciationTypeEnumId,
                        disposed:disposed, acquiredFrom:acquiredFrom, acquiredThru:acquiredThru, pageIndex:pageIndex,
                        pageSize:fetchPageSize}"/>
            <entity-find-one entity-name="mantle.party.Organization" value-field="orgVal">
                <field-map field-name="partyId" from="organizationPartyId"/></entity-find-one>
            <entity-find entity-name="mantle.other.tax.TaxAuthorityParty" list="taxAuthPartyList">
                <date-filter/><econdition field-name="partyId" from="organizationPartyId"/></entity-find>
            <entity-find entity-name="mantle.party.PartyIdentification" list="partyIdentList">
                <econdition field-name="partyId" from="organizationPartyId"/></entity-find>
            <set field="orgName" from="orgVal?.organizationName || organizationPartyId"/>
            <set field="orgVatId" from="taxAuthPartyList?.[0]?.partyTaxId || '—'"/>
            <set field="orgFiscalCode" from="partyIdentList.find(p => p.partyIdTypeEnumId == 'PtidSsn')?.idValue || '—'"/>
            <set field="orgRea" from="partyIdentList.find(p => p.partyIdTypeEnumId == 'PtidREA')?.idValue || '—'"/>
            <set field="totalCost" from="records.reduce((acc, r) => acc + (Number(r.acquireCost) || 0), 0)"/>
            <set field="totalAccumulated" from="records.reduce((acc, r) => acc + (Number(r.accumulated) || 0), 0)"/>
            <set field="totalNetBook" from="records.reduce((acc, r) => acc + (Number(r.netBook) || 0), 0)"/>
            <set field="currencyUomId" from="records?.[0]?.currencyUomId || 'EUR'"/>
            <set field="printDate" from="ec.l10n.format(ec.user.nowTimestamp, 'dd/MM/yyyy HH:mm')"/>
        </if>
        <set field="printUrl"
                from="'/apps/Accounting/FixedAssets/FixedAssets?'
                    + Object.entries(Object.assign({renderMode: 'html-print'},
                    {organizationPartyId:organizationPartyId, classEnumId:classEnumId, assetTypeEnumId:assetTypeEnumId,
                     facilityId:facilityId, depreciationTypeEnumId:depreciationTypeEnumId, disposed:disposed,
                     acquiredFrom:acquiredFrom, acquiredThru:acquiredThru})).filter(entry => entry[1]).map(entry => entry[0] + '='
                    + encodeURIComponent(entry[1])).join('&amp;')"/>
    </actions>
    <widgets>
        <section name="PrintReport" condition="isPrinting">
            <widgets>
                <text type="html,html-print"><![CDATA[
                <style>
                    @page {
                        size: A4 landscape;
                        margin: 12mm 10mm 15mm 10mm;
                        @top-right { content: "Libro Cespiti - Pagina " counter(page); font-size: 8pt; font-family: sans-serif; color: #555; }
                        @bottom-left { content: "${orgName} · P.IVA ${orgVatId} · CF ${orgFiscalCode}"; font-size: 8pt; font-family: sans-serif; color: #555; }
                        @bottom-right { content: "Data stampa: ${printDate}"; font-size: 8pt; font-family: sans-serif; color: #555; }
                    }
                    .asset-report { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 9pt; color: #222; }
                    .header-box { border-bottom: 2px solid #2563eb; padding-bottom: 8px; margin-bottom: 12px; }
                    .org-title { font-size: 14pt; font-weight: bold; color: #1e3a8a; }
                    .report-title { font-size: 12pt; font-weight: bold; text-transform: uppercase; margin-top: 4px; }
                    .meta-row { display: flex; justify-content: space-between; margin-top: 4px; font-size: 8.5pt; color: #444; }
                    table.report-table { width: 100%; border-collapse: collapse; margin-top: 10px; }
                    table.report-table th { background: #f1f5f9; border-top: 1px solid #cbd5e1; border-bottom: 2px solid #94a3b8; padding: 6px 4px; text-align: left; font-size: 8pt; font-weight: 600; text-transform: uppercase; }
                    table.report-table td { border-bottom: 1px solid #e2e8f0; padding: 5px 4px; font-size: 8.5pt; }
                    table.report-table tr:nth-child(even) td { background-color: #fafafa; }
                    .text-right { text-align: right; }
                    .text-center { text-align: center; }
                    .totals-row td { font-weight: bold; background: #e2e8f0 !important; border-top: 2px solid #64748b; border-bottom: 2px solid #64748b; }
                    .sign-box { margin-top: 30px; display: flex; justify-content: space-between; font-size: 8.5pt; }
                    .sign-line { border-top: 1px solid #333; width: 220px; text-align: center; padding-top: 4px; margin-top: 35px; }
                </style>
                <div class="asset-report">
                    <div class="header-box">
                        <div class="meta-row">
                            <div>
                                <div class="org-title">${orgName}</div>
                                <div>Partita IVA: <strong>${orgVatId}</strong> · Codice Fiscale: <strong>${orgFiscalCode}</strong> · REA: <strong>${orgRea}</strong></div>
                            </div>
                            <div style="text-align: right;">
                                <div class="report-title">Registro dei Beni Ammortizzabili</div>
                                <div style="font-size: 9pt; color: #64748b;">(Libro Cespiti - Art. 16 D.P.R. 600/73)</div>
                                <div>Data Stampa: ${printDate}</div>
                            </div>
                        </div>
                    </div>
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th style="width: 80px;">Codice</th>
                                <th>Descrizione Bene / Matricola</th>
                                <th style="width: 110px;">Classe / Categoria</th>
                                <th style="width: 80px;" class="text-center">Data Acq.</th>
                                <th style="width: 80px;" class="text-center">Inizio Util.</th>
                                <th style="width: 90px;">Metodo</th>
                                <th style="width: 90px;" class="text-right">Costo Storico</th>
                                <th style="width: 90px;" class="text-right">Fondo Amm.</th>
                                <th style="width: 90px;" class="text-right">Valore Netto</th>
                                <th style="width: 70px;" class="text-center">Stato</th>
                            </tr>
                        </thead>
                        <tbody>
                ]]></text>
                <iterate list="records" entry="rec">
                    <text type="html,html-print"><![CDATA[
                            <tr>
                                <td><code>${rec.assetId}</code></td>
                                <td><strong>${rec.assetName}</strong></td>
                                <td>${rec.classText || '—'}</td>
                                <td class="text-center">${rec.acquiredDate ? ec.l10n.format(rec.acquiredDate, 'dd/MM/yyyy') : '—'}</td>
                                <td class="text-center">${rec.inServiceText || '—'}</td>
                                <td>${rec.methodText || 'Quote costanti'}</td>
                                <td class="text-right">${ec.l10n.format(rec.acquireCost, '#,##0.00')} ${currencyUomId}</td>
                                <td class="text-right">${ec.l10n.format(rec.accumulated, '#,##0.00')} ${currencyUomId}</td>
                                <td class="text-right"><strong>${ec.l10n.format(rec.netBook, '#,##0.00')} ${currencyUomId}</strong></td>
                                <td class="text-center">${rec.stateText}</td>
                            </tr>
                    ]]></text>
                </iterate>
                <text type="html,html-print"><![CDATA[
                            <tr class="totals-row">
                                <td colspan="6" class="text-right">TOTALI GENERALI:</td>
                                <td class="text-right">${ec.l10n.format(totalCost, '#,##0.00')} ${currencyUomId}</td>
                                <td class="text-right">${ec.l10n.format(totalAccumulated, '#,##0.00')} ${currencyUomId}</td>
                                <td class="text-right">${ec.l10n.format(totalNetBook, '#,##0.00')} ${currencyUomId}</td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="sign-box">
                        <div>Numero Cespiti a Registro: <strong>${records.length}</strong></div>
                        <div class="sign-line">Firma del Legale Rappresentante</div>
                    </div>
                </div>
                ]]></text>
            </widgets>
        </section>
        <section name="ScreenView" condition="!isPrinting">
            <widgets>
                <container style="row items-center q-col-gutter-sm">
                    <container style="col">
                        <label text="Fixed assets" type="h5"/>
                    </container>
                    <container style="col-auto row q-gutter-sm">
                        <link url="${printUrl}"
                                url-type="plain"
                                text="Print / Libro Cespiti"
                                icon="sym_o_print"
                                target-window="_blank"
                                condition="organizationPartyId"/>
                        <link url="${sharedLinks['FixedAssets/AssetClasses']}"
                                text="Asset classes"
                                icon="sym_o_category"
                                parameter-map="{organizationPartyId:organizationPartyId}"/>
                        <link url="${sharedLinks['FixedAssets/DepreciationRunDetail']}"
                                text="Run depreciation"
                                btn-type="primary"
                                icon="sym_o_calculate"
                                condition="canPostLedger"
                                parameter-map="{organizationPartyId:organizationPartyId}"/>
                    </container>
                </container>
        <form-list name="Assets"
                list="records"
                skip-form="true"
                paginate="true"
                header-dialog="true"
                select-columns="true">
            <field name="organizationPartyId">
                <header-field>
                    <hidden/>
                </header-field>
            </field>
            <field name="assetName">
                <default-field title="Asset">
                    <link url="${sharedLinks['FixedAssets/EquipmentDetail']}"
                            text="${assetName}"
                            link-type="anchor"
                            parameter-map="{assetId:assetId, organizationPartyId:organizationPartyId}"/>
                </default-field>
            </field>
            <field name="classEnumId">
                <header-field title="Class">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices"
                                server-search="true"
                                min-length="0"
                                parameter-map="{choice:'assetClasses', organizationPartyId:organizationPartyId,
                                    selected:classEnumId}"/>
                    </drop-down>
                </header-field>
                <default-field title="Class">
                    <display text="${classText}"/>
                </default-field>
            </field>
            <field name="assetTypeEnumId">
                <header-field title="Type">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices"
                                server-search="true"
                                min-length="0"
                                parameter-map="{choice:'fixedAssetTypes', organizationPartyId:organizationPartyId,
                                    selected:assetTypeEnumId}"/>
                    </drop-down>
                </header-field>
                <default-field title="Type">
                    <display text="${typeText}"/>
                </default-field>
            </field>
            <field name="inServiceText">
                <default-field title="In service">
                    <display/>
                </default-field>
            </field>
            <field name="acquiredFrom">
                <header-field title="Acquired from">
                    <date-time type="date"/>
                </header-field>
            </field>
            <field name="acquiredThru">
                <header-field title="Acquired through">
                    <date-time type="date"/>
                </header-field>
            </field>
            <field name="acquireCost" align="right">
                <default-field title="Cost">
                    <display currency-unit-field="currencyUomId"/>
                </default-field>
            </field>
            <field name="accumulated" align="right">
                <default-field title="Depreciation">
                    <display currency-unit-field="currencyUomId"/>
                </default-field>
            </field>
            <field name="netBook" align="right">
                <default-field title="Net book">
                    <display currency-unit-field="currencyUomId"/>
                </default-field>
            </field>
            <field name="depreciationTypeEnumId">
                <header-field title="Method">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices"
                                server-search="true"
                                min-length="0"
                                parameter-map="{choice:'depreciationMethods', organizationPartyId:organizationPartyId,
                                    selected:depreciationTypeEnumId}"/>
                    </drop-down>
                </header-field>
                <default-field title="Method">
                    <display text="${methodText}"/>
                </default-field>
            </field>
            <field name="facilityId">
                <header-field title="Location">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="choices"
                                server-search="true"
                                min-length="0"
                                parameter-map="{choice:'facilities', organizationPartyId:organizationPartyId,
                                    selected:facilityId}"/>
                    </drop-down>
                </header-field>
                <default-field title="Location">
                    <display text="${facilityText}"/>
                </default-field>
            </field>
            <field name="disposed">
                <header-field title="Disposed">
                    <drop-down allow-empty="true">
                        <option key="N" text="In use"/>
                        <option key="Y" text="Disposed"/>
                    </drop-down>
                </header-field>
            </field>
            <field name="stateText">
                <default-field title="Book">
                    <render-mode>
                        <text type="qvt"><![CDATA[<q-chip dense square class="q-ma-none m-tonal text-${stateColor}">${
                            stateText}</q-chip>]]></text>
                        <text type="tui"><![CDATA[${JSON.stringify({t: "text", style: "strong", text: stateText})}]]></text>
                        <text type="html">${stateText}</text>
                    </render-mode>
                </default-field>
            </field>
            <columns type="mobile">
                <column>
                    <field-ref name="assetName"/>
                    <field-ref name="classEnumId"/>
                </column>
                <column>
                    <field-ref name="netBook"/>
                    <field-ref name="stateText"/>
                </column>
            </columns>
        </form-list>
        <label text="No fixed assets for this organization. Equipment it receives or records shows here to be capitalized."
                type="p"
                condition="organizationPartyId &amp;&amp; !records.length"/>
        <label text="Choose an organization to see its fixed assets." type="p" condition="!organizationPartyId"/>
            </widgets>
        </section>
    </widgets>
</screen>
