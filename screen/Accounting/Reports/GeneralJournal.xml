<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        default-menu-title="General journal"
        default-menu-index="2"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd">
    <parameter name="organizationPartyId"/>
    <parameter name="fiscalYear"/>
    <parameter name="timePeriodId"/>
    <parameter name="fromDate"/>
    <parameter name="thruDate"/>
    <parameter name="pageStartingNumber"/>
    <parameter name="renderMode"/>

    <transition-include name="choices" location="component://mr-boss/template/AccountingParts.xml"/>

    <transition name="finalizeJournal">
        <actions>
            <service-call name="mantle.ledger.FiscalRegisterServices.finalize#GeneralJournalPeriod"
                    in-map="{organizationPartyId:organizationPartyId, fiscalYear:fiscalYear,
                        timePeriodId:timePeriodId, fromDate:fromDate, thruDate:thruDate}"/>
        </actions>
        <default-response url="."/>
        <error-response url="."/>
    </transition>

    <actions>
        <set field="isPrinting" from="String(ec.web?.requestParameters?.renderMode || context.renderMode || '') == 'html-print'"/>
        <if condition="!organizationPartyId">
            <set field="organizationPartyId" from="ec.user.getPreference('OrganizationPartyId') || 'ORG_ZIZI_CORP'"/>
        </if>
        <if condition="!fiscalYear">
            <set field="fiscalYear" from="String(new Date().getFullYear())"/>
        </if>

        <set field="journalData" from="{}"/>
        <if condition="organizationPartyId">
            <service-call name="mantle.ledger.FiscalRegisterServices.get#GeneralJournalData"
                    in-map="{organizationPartyId:organizationPartyId, fiscalYear:fiscalYear,
                        timePeriodId:timePeriodId, fromDate:fromDate, thruDate:thruDate,
                        pageStartingNumber:(pageStartingNumber ? parseInt(pageStartingNumber, 10) : null)}"
                    out-map="journalData"/>
        </if>

        <set field="printUrl"
                from="'/apps/Accounting/Reports/GeneralJournal?'
                    + Object.entries({renderMode:'html-print', organizationPartyId:organizationPartyId,
                        fiscalYear:fiscalYear, timePeriodId:timePeriodId, fromDate:fromDate, thruDate:thruDate,
                        pageStartingNumber:pageStartingNumber})
                        .filter(e =&gt; e[1] != null &amp;&amp; e[1] !== '')
                        .map(e =&gt; e[0] + '=' + encodeURIComponent(e[1])).join('&amp;')"/>
    </actions>
    <widgets>
        <!-- PRINT / PDF RENDER MODE -->
        <section name="PrintMode" condition="isPrinting">
            <widgets>
                <render-mode>
                    <text type="html,html-print"><![CDATA[
                    <style>
                        @page {
                            size: A4 portrait;
                            margin: 12mm 10mm 15mm 10mm;
                            @bottom-right {
                                content: counter(page);
                            }
                        }
                        body {
                            font-family: 'Courier New', Courier, monospace;
                            font-size: 9pt;
                            color: #111;
                            background: #fff;
                        }
                        .journal-page {
                            page-break-after: always;
                            margin-bottom: 25px;
                        }
                        .journal-header {
                            border-bottom: 2px solid #222;
                            padding-bottom: 6px;
                            margin-bottom: 8px;
                        }
                        .header-row {
                            display: flex;
                            justify-content: space-between;
                        }
                        .company-name {
                            font-size: 11pt;
                            font-weight: bold;
                        }
                        .company-fiscal {
                            font-size: 8.5pt;
                            color: #444;
                        }
                        .register-title {
                            font-size: 12pt;
                            font-weight: bold;
                            text-align: center;
                            margin: 6px 0;
                            text-transform: uppercase;
                        }
                        .page-number-box {
                            text-align: right;
                            font-weight: bold;
                            font-size: 10pt;
                        }
                        .journal-table {
                            width: 100%;
                            border-collapse: collapse;
                            font-size: 8.5pt;
                        }
                        .journal-table th {
                            border-top: 1px solid #333;
                            border-bottom: 1px solid #333;
                            padding: 3px 4px;
                            text-align: left;
                            font-weight: bold;
                        }
                        .journal-table td {
                            padding: 2px 4px;
                            vertical-align: top;
                        }
                        .amount {
                            text-align: right;
                            font-family: monospace;
                        }
                        .tx-header-row td {
                            font-weight: bold;
                            border-top: 1px dotted #888;
                            padding-top: 4px;
                            background-color: #f9f9f9;
                        }
                        .carry-row {
                            font-weight: bold;
                            background-color: #eee;
                            border-top: 1px solid #222;
                            border-bottom: 1px solid #222;
                        }
                        .watermark {
                            color: #c33;
                            font-weight: bold;
                            text-align: center;
                            font-size: 9pt;
                            padding: 2px 0;
                        }
                    </style>
                    ]]></text>
                </render-mode>
                <section-iterate name="PrintPages" list="journalData?.pages || []" entry="page">
                    <widgets>
                        <render-mode>
                            <text type="html,html-print"><![CDATA[
                    <div class="journal-page">
                        <div class="journal-header">
                            <div class="header-row">
                                <div>
                                    <div class="company-name">${journalData.organization?.organizationName || ''}</div>
                                    <div class="company-fiscal">
                                        ${ec.l10n.localize('VAT ID')}: ${journalData.organization?.taxIdNumber || '—'} | ${ec.l10n.localize('Fiscal Code')}: ${journalData.organization?.socialSecurityNumber || '—'} | ${ec.l10n.localize('R.E.A.')}: ${journalData.organization?.reaNumber || '—'}
                                    </div>
                                </div>
                                <div class="page-number-box">
                                    ${ec.l10n.localize('PAGE')} ${page.pageLabel}
                                </div>
                            </div>
                            <div class="register-title">${ec.l10n.localize('GENERAL JOURNAL - FISCAL YEAR')} ${journalData.fiscalYear}</div>
                            <div class="header-row">
                                <div>${ec.l10n.localize('Period')}: ${journalData.periodDescription}</div>
                                <div class="watermark">${ec.l10n.localize('DRAFT PRINT - NON-FISCAL DOCUMENT')}</div>
                            </div>
                        </div>

                        <table class="journal-table">
                            <thead>
                                <tr>
                                    <th style="width: 75px;">${ec.l10n.localize('Date')}</th>
                                    <th style="width: 55px;">${ec.l10n.localize('Entry No.')}</th>
                                    <th style="width: 85px;">${ec.l10n.localize('Account')}</th>
                                    <th>${ec.l10n.localize('Account Description / Transaction Reason')}</th>
                                    <th style="width: 85px;" class="amount">${ec.l10n.localize('Debit (€)')}</th>
                                    <th style="width: 85px;" class="amount">${ec.l10n.localize('Credit (€)')}</th>
                                </tr>
                            ]]></text>
                        </render-mode>
                        <section name="PrintBroughtForward" condition="(page.broughtForwardDebit || 0) &gt; 0 || (page.broughtForwardCredit || 0) &gt; 0">
                            <widgets>
                                <render-mode>
                                    <text type="html,html-print"><![CDATA[
                                <tr class="carry-row">
                                    <td colspan="4">${ec.l10n.localize('TOTAL BROUGHT FORWARD FROM PREVIOUS PAGE')}</td>
                                    <td class="amount">${ec.l10n.format(page.broughtForwardDebit || 0, '#,##0.00')}</td>
                                    <td class="amount">${ec.l10n.format(page.broughtForwardCredit || 0, '#,##0.00')}</td>
                                </tr>
                                    ]]></text>
                                </render-mode>
                            </widgets>
                        </section>
                        <render-mode>
                            <text type="html,html-print"><![CDATA[
                            </thead>
                            <tbody>
                            ]]></text>
                        </render-mode>
                        <section-iterate name="PrintTx" list="page.transactions || []" entry="tx">
                            <widgets>
                                <render-mode>
                                    <text type="html,html-print"><![CDATA[
                                    <tr class="tx-header-row">
                                        <td>${tx.transactionDate ? ec.l10n.format(tx.transactionDate, 'yyyy-MM-dd') : ''}</td>
                                        <td>#${tx.journalSequenceNum}</td>
                                        <td colspan="4">
                                            ${tx.txDescription || ''}
                                            ${tx.txVoucherRef ? (' [Doc: ' + tx.txVoucherRef + ']') : ''}
                                            ${tx.invoiceId ? (' (' + ec.l10n.localize('Invoice') + ': ' + tx.invoiceId + ')') : ''}
                                            ${tx.paymentId ? (' (' + ec.l10n.localize('Payment') + ': ' + tx.paymentId + ')') : ''}
                                        </td>
                                    </tr>
                                    ]]></text>
                                </render-mode>
                                <section-iterate name="PrintEntries" list="tx.entries || []" entry="entry">
                                    <widgets>
                                        <render-mode>
                                            <text type="html,html-print"><![CDATA[
                                    <tr>
                                        <td></td>
                                        <td></td>
                                        <td>${entry.accountCode || ''}</td>
                                        <td>${entry.accountName || ''}</td>
                                        <td class="amount">${entry.debitAmount > 0 ? ec.l10n.format(entry.debitAmount, '#,##0.00') : ''}</td>
                                        <td class="amount">${entry.creditAmount > 0 ? ec.l10n.format(entry.creditAmount, '#,##0.00') : ''}</td>
                                    </tr>
                                            ]]></text>
                                        </render-mode>
                                    </widgets>
                                </section-iterate>
                            </widgets>
                        </section-iterate>
                        <render-mode>
                            <text type="html,html-print"><![CDATA[
                            </tbody>
                            <tfoot>
                                <tr class="carry-row">
                                    <td colspan="4">${ec.l10n.localize('PROGRESSIVE TOTAL CARRIED FORWARD')}</td>
                                    <td class="amount">${ec.l10n.format(page.carriedForwardDebit || 0, '#,##0.00')}</td>
                                    <td class="amount">${ec.l10n.format(page.carriedForwardCredit || 0, '#,##0.00')}</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                            ]]></text>
                        </render-mode>
                    </widgets>
                </section-iterate>
            </widgets>
        </section>

        <!-- INTERACTIVE SCREEN RENDER MODE -->
        <section name="InteractiveMode" condition="!isPrinting">
            <widgets>
                <container style="row items-center q-col-gutter-sm q-mb-md">
                    <container style="col">
                        <label text="General journal" type="h4"/>
                        <label text="Mandatory chronological register of double-entry accounting records (Art. 2216 Italian Civil Code)"
                                type="p" style="m-muted"/>
                    </container>
                    <container style="col-auto">
                        <link url="${printUrl}"
                                url-type="plain"
                                text="Print / PDF"
                                icon="sym_o_print"
                                target-window="_blank"
                                condition="journalData?.pages?.length"/>
                        <container-dialog id="FinalizeJournalDialog" button-text="Finalize register" title="Finalize period and lock entries"
                                condition="journalData?.pages?.length">
                            <form-single name="FinalizeJournalForm" transition="finalizeJournal">
                                <field name="organizationPartyId" from="organizationPartyId"><default-field><hidden/></default-field></field>
                                <field name="fiscalYear" from="fiscalYear"><default-field><hidden/></default-field></field>
                                <field name="timePeriodId" from="timePeriodId"><default-field><hidden/></default-field></field>
                                <field name="fromDate" from="journalData.fromDate"><default-field title="From date"><display/></default-field></field>
                                <field name="thruDate" from="journalData.thruDate"><default-field title="Thru date"><display/></default-field></field>
                                <field name="pageCount"><default-field title="Pages to number">
                                    <display text="${journalData.startPageNumber} - ${journalData.endPageNumber}"/></default-field></field>
                                <field name="totalDebitAmount"><default-field title="Total Debit">
                                    <display text="${journalData.totalDebit}"/></default-field></field>
                                <field name="totalCreditAmount"><default-field title="Total Credit">
                                    <display text="${journalData.totalCredit}"/></default-field></field>
                                <field name="confirmNote"><default-field title="">
                                    <label text="Warning: finalization will permanently assign continuous annual sequential numbers and log totals in the fiscal register." style="text-warning"/>
                                </default-field></field>
                                <field name="submitButton"><default-field title="Confirm and finalize"><submit/></default-field></field>
                            </form-single>
                        </container-dialog>
                    </container>
                </container>

                <!-- Filter form -->
                <container-box>
                    <box-header title="Register filters"/>
                    <box-body>
                        <form-single name="JournalFilter" transition=".">
                            <field name="organizationPartyId">
                                <default-field title="Organization">
                                    <drop-down allow-empty="false">
                                        <entity-options key="${partyId}" text="${organizationName}">
                                            <entity-find entity-name="mantle.party.Organization">
                                                <order-by field-name="organizationName"/>
                                            </entity-find>
                                        </entity-options>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="fiscalYear">
                                <default-field title="Fiscal year">
                                    <text-line size="6"/>
                                </default-field>
                            </field>
                            <field name="timePeriodId">
                                <default-field title="Fiscal period">
                                    <drop-down allow-empty="true">
                                        <entity-options key="${timePeriodId}" text="${periodName || timePeriodId}">
                                            <entity-find entity-name="mantle.party.time.TimePeriod">
                                                <econdition field-name="partyId" from="organizationPartyId"/>
                                                <order-by field-name="-fromDate"/>
                                            </entity-find>
                                        </entity-options>
                                    </drop-down>
                                </default-field>
                            </field>
                            <field name="fromDate">
                                <default-field title="From"><date-time type="date"/></default-field>
                            </field>
                            <field name="thruDate">
                                <default-field title="Thru"><date-time type="date"/></default-field>
                            </field>
                            <field name="pageStartingNumber">
                                <default-field title="Starting page no.">
                                    <text-line size="6"/>
                                </default-field>
                            </field>
                            <field name="submitButton">
                                <default-field title="View register"><submit/></default-field>
                            </field>
                            <field-layout>
                                <field-row>
                                    <field-ref name="organizationPartyId"/>
                                    <field-ref name="fiscalYear"/>
                                    <field-ref name="timePeriodId"/>
                                </field-row>
                                <field-row>
                                    <field-ref name="fromDate"/>
                                    <field-ref name="thruDate"/>
                                    <field-ref name="pageStartingNumber"/>
                                    <field-ref name="submitButton"/>
                                </field-row>
                            </field-layout>
                        </form-single>
                    </box-body>
                </container-box>

                <!-- Summary Statistics -->
                <section name="JournalSummarySection" condition="journalData?.totalTransactions != null">
                    <widgets>
                        <container style="row q-col-gutter-sm q-mt-md">
                            <container style="col-12 col-md-3">
                                <container-box>
                                    <box-header title="Entries"/>
                                    <box-body>
                                        <label text="${journalData.totalTransactions}" type="h3"/>
                                        <label text="${journalData.totalEntries} ${ec.l10n.localize('accounting lines')}" type="div" style="m-muted"/>
                                    </box-body>
                                </container-box>
                            </container>
                            <container style="col-12 col-md-3">
                                <container-box>
                                    <box-header title="Total Debit (€)"/>
                                    <box-body>
                                        <label text="${journalData.totalDebit}" type="h3" style="text-primary"/>
                                    </box-body>
                                </container-box>
                            </container>
                            <container style="col-12 col-md-3">
                                <container-box>
                                    <box-header title="Total Credit (€)"/>
                                    <box-body>
                                        <label text="${journalData.totalCredit}" type="h3" style="text-primary"/>
                                    </box-body>
                                </container-box>
                            </container>
                            <container style="col-12 col-md-3">
                                <container-box>
                                    <box-header title="Balance and Pages"/>
                                    <box-body>
                                        <label text="Imbalance: 0.00 €" type="strong" style="color: green;"
                                                condition="journalData.totalDebit == journalData.totalCredit"/>
                                        <label text="WARNING: Register unbalanced!" type="strong" style="color: red;"
                                                condition="journalData.totalDebit != journalData.totalCredit"/>
                                        <label text="${ec.l10n.localize('Pages')}: ${journalData.startPageNumber} - ${journalData.endPageNumber} (${journalData.pages?.length} ${ec.l10n.localize('pp.')})" type="div" style="m-muted"/>
                                    </box-body>
                                </container-box>
                            </container>
                        </container>
                    </widgets>
                </section>

                <!-- Data Table preview -->
                <section name="JournalPreviewSection" condition="journalData?.pages?.length">
                    <widgets>
                        <container-box>
                            <box-header title="General Journal Preview"/>
                            <box-body>
                                <section-iterate name="JournalPages" list="journalData.pages" entry="page">
                                    <widgets>
                                        <container style="q-pa-sm q-mb-sm bg-grey-2 rounded-borders row justify-between items-center">
                                            <label text="${ec.l10n.localize('Page')} ${page.pageLabel}" type="strong"/>
                                            <label text="${ec.l10n.localize('Brought Forward Debit')}: € ${page.broughtForwardDebit} | ${ec.l10n.localize('Credit')}: € ${page.broughtForwardCredit}" style="m-muted"
                                                    condition="(page.broughtForwardDebit || 0) &gt; 0 || (page.broughtForwardCredit || 0) &gt; 0"/>
                                        </container>
                                        <section-iterate name="JournalTx" list="page.transactions" entry="tx">
                                            <widgets>
                                                <container style="border-bottom: 1px solid #ddd; q-py-xs">
                                                    <container style="row justify-between bg-blue-grey-1 q-pa-xs">
                                                        <container style="col-auto">
                                                            <label text="${tx.transactionDate} - ${ec.l10n.localize('Reg. #')}${tx.journalSequenceNum}" type="strong"/>
                                                        </container>
                                                        <container style="col">
                                                            <label text=" - ${tx.txDescription} ${tx.txVoucherRef ? ('[Doc: ' + tx.txVoucherRef + ']') : ''}"/>
                                                        </container>
                                                    </container>
                                                    <section-iterate name="TxEntries" list="tx.entries" entry="entry">
                                                        <widgets>
                                                            <container style="row q-px-sm q-py-xs text-caption">
                                                                <container style="col-2"><label text="${entry.accountCode}"/></container>
                                                                <container style="col-6"><label text="${entry.accountName}"/></container>
                                                                <container style="col-2 text-right"><label text="${entry.debitAmount &gt; 0 ? entry.debitAmount : ''}"/></container>
                                                                <container style="col-2 text-right"><label text="${entry.creditAmount &gt; 0 ? entry.creditAmount : ''}"/></container>
                                                            </container>
                                                        </widgets>
                                                    </section-iterate>
                                                </container>
                                            </widgets>
                                        </section-iterate>
                                        <container style="q-pa-sm q-mt-xs q-mb-md bg-grey-3 row justify-between text-weight-bold">
                                            <label text="Progressive total carried forward:"/>
                                            <label text="${ec.l10n.localize('Debit')}: € ${page.carriedForwardDebit} | ${ec.l10n.localize('Credit')}: € ${page.carriedForwardCredit}"/>
                                        </container>
                                    </widgets>
                                </section-iterate>
                            </box-body>
                        </container-box>
                    </widgets>
                </section>
            </widgets>
        </section>
    </widgets>
</screen>
